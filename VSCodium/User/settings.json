{
    "godotTools.editorPath.godot4": "godot-mono",
    "editor.fontFamily": "'FiraCode Nerd Font Med', 'monospace', monospace",
    "editor.fontLigatures": true,
    "terminal.external.linuxExec": "kitty",
    "terminal.integrated.defaultProfile.linux": "fish",
    "workbench.iconTheme": "material-icon-theme",
    "terminal.integrated.fontLigatures.enabled": true,
    "files.exclude": {
        "**/.git": false
    },
    "editor.formatOnSave": true,
    "[csharp]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode"
    },
    "python-envs.alwaysUseUv": false,
    "editor.lineNumbers": "relative",
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "K"
            ],
            "after": [
                "g",
                "h"
            ]
        }
    ],
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-s>": false,
        "<C-z>": false,
        "<C-b>": false,
        "<C-o>": false,
        "<C-k>": false,
        "<C-h>": false,
    },
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "<C-y>",
            ],
            "commands": [
                "acceptSelectedSuggestion"
            ]
        }
    ],
    "redhat.telemetry.enabled": true,
    "vim.useSystemClipboard": true,
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "xmlTools.splitAttributesOnFormat": true,
    "workbench.editorAssociations": {
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "qt-core.additionalQtPaths": [
        {
            "name": "Qt-5.15.18-linux-g++_from_PATH",
            "path": "/usr/bin/qmake"
        }
    ],
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.user",
        "*.json": "${capture}.Development.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "qt-core.qtInstallationRoot": "/home/ken/code/proto/qt_ui/venv/lib/python3.14/site-packages/PySide6",
    "python.pyrefly.displayTypeErrors": "force-on",
    "workbench.colorTheme": "Material Palenight Theme",
    "basedpyright.disableLanguageServices": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "python.languageServer": "Default",
    "notebook.formatOnSave.enabled": true,
    "python.pyrefly.diagnosticMode": "workspace",
    "python.pyrefly.typeCheckingMode": "default",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    }
}